# Allow lightweight placeholders in local asset roots.
!assets/
!assets/checkpoints/
assets/checkpoints/**/*
!assets/checkpoints/*/
!assets/checkpoints/*/.gitkeep
!priors/
priors/**/*
!priors/.gitkeep

# Vendored source trees are tracked. Keep ignore rules here narrow so source
# directories named "models", "assets", or "data" are not hidden by accident.
third_party/**/__pycache__/
third_party/**/*.py[cod]
third_party/**/.pytest_cache/
third_party/**/.mypy_cache/
third_party/**/.ruff_cache/
third_party/**/.ipynb_checkpoints/
third_party/**/build/
third_party/**/dist/
third_party/**/*.egg-info/
third_party/**/.eggs/
third_party/**/CMakeCache.txt
third_party/**/CMakeFiles/
third_party/**/cmake_install.cmake
third_party/**/compile_commands.json
third_party/**/build.ninja
third_party/**/.ninja_deps
third_party/**/.ninja_log
third_party/**/checkpoints/
third_party/**/checkpoints
third_party/**/runs/
third_party/**/outputs/
third_party/**/output/
third_party/**/logs/
third_party/**/wandb/
third_party/**/drivestudio_exp/
third_party/**/*tmp*/

