# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Python caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
.coverage.*
htmlcov/

# Build products
build/
dist/
develop-eggs/
eggs/
.eggs/
parts/
wheels/
*.egg-info/
*.egg
*.so
*.o
*.cuo
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
build.ninja
.ninja_deps
.ninja_log

# Environments and local config
.env
.env.*
.venv/
venv/
env/
ENV/
conda-meta/
*.local
local_config.*
